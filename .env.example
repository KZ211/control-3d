# Copiá este archivo como .env.local y completá con los datos de
# Supabase > Project Settings > API (o "Connect" > App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La clave publicable (sb_publishable_...) o la "anon" de las claves legacy.
# Nunca pongas acá la service_role / secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
